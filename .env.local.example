# MySQL Database Configuration
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=clinic_db

# API Configuration
NEXT_PUBLIC_API_URL=

# Note: If you don't have MySQL set up yet, the app will run in demo mode
# and use demo credentials. To use real database, create .env.local with
# the above values filled in with your MySQL credentials.
